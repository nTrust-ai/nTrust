# Security Headers Configuration
# NIST AI RMF & EU AI Act Compliant

/* Apply to all responses */
Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://api.ntrust.ai; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; report-uri https://o365.cdn.office.net/report/
X-Content-Type-Options: nosniff
X-Frame-Options: DENY
Referrer-Policy: strict-origin-when-cross-origin
Permissions-Policy: accelerometer=(), camera=(), gyroscope=(), magnetometer=(), payment=(), usb=()
Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0
X-XSS-Protection: 1; mode=block
Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
X-DNS-Prefetch-Control: off
X-Download-Options: noopen
Expect-CT: max-age=86400; report-uri="https://o365.cdn.office.net/report/expect-ct-report"

/* Apply to all static assets */
Cache-Control: public, max-age=31536000, immutable
X-Content-Type-Options: nosniff
X-Frame-Options: SAMEORIGIN
