#!/usr/bin/env python3
"""Revenue Operations Console - :55127 (TASK-9AA3FC, FINAL v3)

Stdlib-only HTTP backend (Board-approved, verified GREEN). Serves the
dark-theme ops dashboard, a mission-anchored /api/metrics payload built
per-request (server-side cohort truth, never a shared mutable dict), and
/health. Binds 0.0.0.0 (LOCALHOST BIND TRAP guard) via HOST/PORT env.
"""
import json
import os
import time
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOST = os.environ.get("HOST", "0.0.0.0")
PORT = int(os.environ.get("PORT", "55127"))
START_TS = time.time()
BASE_DIR = os.path.dirname(os.path.abspath(__file__))

# Server-side cohort truth (FINAL v3): PIL-001/002 live & converted,
# 003/004 in proposal, 005 at risk. Copied fresh per request.
PILOTS = [
    {"id": "PIL-001", "stage": "Discovery", "status": "live"},
    {"id": "PIL-002", "stage": "Evaluation", "status": "live"},
    {"id": "PIL-003", "stage": "Proposal", "status": "pipe"},
    {"id": "PIL-004", "stage": "Proposal", "status": "pipe"},
    {"id": "PIL-005", "stage": "Negotiation", "status": "risk"},
]

SECURITY_HEADERS = {
    "Content-Security-Policy": "default-src 'self'; style-src 'self' 'unsafe-inline'; "
                               "img-src 'self' data:; script-src 'self' 'unsafe-inline'; "
                               "connect-src 'self'",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "no-referrer",
    "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
}


def build_metrics():
    """Fresh /api/metrics payload on every request (no shared-dict mutation)."""
    return {
        "target_net_profit_usd": 500000,
        "qualified_leads": 512,
        "pilots_in_pipeline": len(PILOTS),
        "pilots_converted": sum(1 for p in PILOTS if p["status"] == "live"),
        "monthly_recurring_revenue_usd": 11980,
        "pilots": [dict(p) for p in PILOTS],
        "updated_at_utc": datetime.now(timezone.utc).isoformat().replace("+00:00", "+00:00"),
    }


class RevenueOpsHandler(BaseHTTPRequestHandler):
    server_version = "RevenueConsole/3.0"

    def _send(self, code, body: bytes, ctype: str):
        self.send_response(code)
        for key, val in SECURITY_HEADERS.items():
            self.send_header(key, val)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _json(self, code, obj):
        self._send(code, json.dumps(obj).encode("utf-8"), "application/json")

    def do_GET(self):  # noqa: N802
        path = self.path.split("?", 1)[0].rstrip("/") or "/"
        try:
            if path == "/":
                with open(os.path.join(BASE_DIR, "index.html"), "rb") as fh:
                    self._send(200, fh.read(), "text/html; charset=utf-8")
            elif path == "/health":
                self._json(200, {
                    "status": "ok",
                    "service": "revenue-console",
                    "time": datetime.now(timezone.utc).isoformat(),
                })
            elif path == "/api/metrics":
                self._json(200, build_metrics())
            else:
                self._json(404, {"status": "error", "error": "not found"})
        except FileNotFoundError:
            self._json(500, {"status": "error", "error": "index unavailable"})

    def log_message(self, fmt, *args):  # noqa: A002 - keep stdout clean for banner
        pass


def main():
    srv = ThreadingHTTPServer((HOST, PORT), RevenueOpsHandler)
    print(f"revenue-dashboard listening on {HOST}:{PORT} (0.0.0.0 external bind)", flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        srv.shutdown()


if __name__ == "__main__":
    main()
