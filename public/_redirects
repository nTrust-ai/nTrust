# nTrust.ai — canonical redirects & rewrites (Cloudflare Pages)

# www subdomain → apex canonical (301)
https://www.ntrust.ai/* https://ntrust.ai/:splat 301

# Executive Profile — serve sanitized bio at HTTP 200
/naveed /naveed/index.html 200
/naveed/ /naveed/index.html 200
/executive /naveed/index.html 301
/executive/ /naveed/index.html 301

# Spine Product Links & Open Source Redirects → spine.ntrust.ai
/spine.html https://spine.ntrust.ai 301
/spine https://spine.ntrust.ai 301
/spine/* https://spine.ntrust.ai/:splat 301
/open-source https://spine.ntrust.ai 301
/open-source/ https://spine.ntrust.ai 301
/open-source/* https://spine.ntrust.ai 301

# TrustGuard durable routes
/trustguard /trustguard/index.html 200
/trustguard/ /trustguard/index.html 200
/trustguard/dashboard /trustguard/dashboard.html 200
/trustguard/health /trustguard/health.json 200

# TokenShield durable routes
/tokenshield /products/tokenshield 301
/tokenshield/ /products/tokenshield 301

# Legacy ASPM/AppSOC deep links -> consolidated Managed AppSec Services page
/products/appsoc.html  /products/managed-appsec.html  301
/products/aspm.html    /products/managed-appsec.html  301

# Clean public site rewrites for legacy staging
/coming-soon/* / 200
/legacy/* / 200
/staging/* / 200
/dev/* / 200
/test/* / 200
/mvp/* / 200
/phase1/* / 200
/phase2/* / 200
/api-test/* / 200
